# ==============================================================================
# VERO LUXURY ACCESSORIES - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this template to .env and fill in your actual production values:
#   cp .env.example .env
# NEVER commit the real .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT (REQUIRED)
# ------------------------------------------------------------------------------
# Runtime environment: 'production' for VPS deployment, 'development' for local
NODE_ENV=production

# Application listening port (3000 inside the container)
PORT=3000

# Canonical Public Domain for VERO Luxury
APP_URL=https://vero-accessoires.store

# Session and cookie encryption secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_secure_64_character_random_hex_secret

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (REQUIRED FOR SELF-HOSTED DOCKER ARCHITECTURE)
# ------------------------------------------------------------------------------
# PostgreSQL database name
POSTGRES_DB=vero_db

# PostgreSQL database username
POSTGRES_USER=vero_user

# PostgreSQL strong password (Generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Internal connection URL used by the vero-app container
# Hostname 'postgres' matches the service name in docker-compose.yml
DATABASE_URL=postgresql://vero_user:replace_with_a_strong_database_password@postgres:5432/vero_db

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 3. SSL & DOMAIN SETTINGS (REQUIRED FOR LET'S ENCRYPT CERTBOT)
# ------------------------------------------------------------------------------
# Email address for urgent Let's Encrypt renewal & security notices
SSL_EMAIL=admin@vero-accessoires.store

# Primary domain and optional aliases
DOMAIN_NAME=vero-accessoires.store
DOMAIN_ALIASES=www.vero-accessoires.store

# ------------------------------------------------------------------------------
# 4. OPTIONAL LEGACY / HYBRID FALLBACK CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase settings (Leave blank when using self-hosted PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
